# BIL Configuration — copy to .env and fill in your values

# NAS IP address
NAS_IP=192.168.1.177

# Service ports
BIL_PORT=8420
QDRANT_PORT=6333
INFINITY_PORT=7997
OLLAMA_PORT=11434

# Brain Drive path (on NAS)
BRAIN_PATH=/volume1/brain

# Ollama URL (for vision/language models)
OLLAMA_URL=http://192.168.1.177:11434

# Cloudflare tunnel domains (optional)
BRAIN_DOMAIN=brain.yourdomain.com
OLLAMA_DOMAIN=ollama.yourdomain.com
